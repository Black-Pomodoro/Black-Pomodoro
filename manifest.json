* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: Arial, sans-serif;
}

body {
  background-color: #0d0d0d;
  color: #ffffff;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
}

.container {
  background-color: #1a1a1a;
  padding: 30px;
  border-radius: 16px;
  text-align: center;
  width: 90%;
  max-width: 400px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.8);
}

h1 {
  font-size: 24px;
  margin-bottom: 20px;
  color: #e50914;
}

.timer-display {
  font-size: 60px;
  font-weight: bold;
  margin: 20px 0;
  letter-spacing: 2px;
}

.inputs, .controls {
  display: flex;
  justify-content: center;
  gap: 10px;
  margin-bottom: 20px;
}

input[type="number"] {
  width: 70px;
  padding: 10px;
  background-color: #2b2b2b;
  border: 1px solid #444;
  color: #fff;
  border-radius: 8px;
  text-align: center;
  font-size: 16px;
}

button {
  padding: 10px 16px;
  border: none;
  border-radius: 8px;
  background-color: #e50914;
  color: #fff;
  font-weight: bold;
  cursor: pointer;
  transition: 0.2s;
}

button:hover {
  background-color: #b20710;
}

.sound-upload {
  margin-top: 15px;
  font-size: 14px;
  color: #aaa;
}

.sound-upload input {
  margin-top: 8px;
  font-size: 12px;
}

.alarm-btn {
  width: 100%;
  margin-top: 15px;
  background-color: #ff9800;
  padding: 12px;
}
